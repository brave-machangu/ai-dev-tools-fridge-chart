# Copy to .env and fill in what you need. Nothing here is required in
# development: the app runs on SQLite and prints reminders to the console.

# --- Required in production ------------------------------------------------
# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=chores.example.com

# --- PostgreSQL (optional; SQLite is used when POSTGRES_DB is unset) --------
# Install the driver first: uv sync --extra postgres
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Email (optional; reminders print to the console when EMAIL_HOST is unset)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=chores@example.com
